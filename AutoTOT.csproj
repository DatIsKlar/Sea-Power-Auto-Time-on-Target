<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AutoTOT</AssemblyName>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- We reference game/Unity/BepInEx DLLs by hint path; don't pull the ref pack -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- Path to the Sea Power install; override with -p:GameDir=... if it moves -->
    <GameDir>/NEW-DRIVE/SteamLibrary/steamapps/common/Sea Power</GameDir>
    <Managed>$(GameDir)/Sea Power_Data/Managed</Managed>
    <BepInExCore>$(GameDir)/BepInEx/core</BepInExCore>
    <!-- AnchorChain chainloader (Steam Workshop item 3380210757) -->
    <AnchorChainDll>/NEW-DRIVE/SteamLibrary/steamapps/workshop/content/1286220/3380210757/AnchorChain.dll</AnchorChainDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- BCL (Mono) -->
    <Reference Include="mscorlib"><HintPath>$(Managed)/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(Managed)/netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(Managed)/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(Managed)/System.Core.dll</HintPath><Private>false</Private></Reference>

    <!-- BepInEx + Harmony -->
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)/0Harmony.dll</HintPath><Private>false</Private></Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine"><HintPath>$(Managed)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>

    <!-- The game -->
    <Reference Include="Seapower-Scripts"><HintPath>$(Managed)/Seapower-Scripts.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniRx"><HintPath>$(Managed)/UniRx.dll</HintPath><Private>false</Private></Reference>

    <!-- AnchorChain chainloader -->
    <Reference Include="AnchorChain"><HintPath>$(AnchorChainDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
