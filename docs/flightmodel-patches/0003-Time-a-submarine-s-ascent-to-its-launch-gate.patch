             if (!GameMath.IsFinite(s.DepthU) || !GameMath.IsFinite(s.TargetDepthU) || s.MaxSpeedKn <= 0f ||
                 s.PitchRateDeg <= 0f || !GameMath.IsFinite(s.SpeedKn)) return false;
 
